.inner {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 2rem;

  @media (max-width: 1024px) {
    padding: 0 1.6rem;
  }

  @media (max-width: 768px) {
    padding: 0 1.2rem;
  }

  @media (max-width: 480px) {
    padding: 0 1rem;
  }
}

.a11y-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  overflow: hidden;
  clip-path: polygon(0 0, 0 0, 0 0);
}