.header{
  position: fixed;
  top: 0;
  margin: 0 auto;
  width: 100%;
  height: 60px;
  z-index: 10;
  transition: all .3s ease;
  background-color: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(3px);

  &__inner{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.2rem;

    h1 {
      font-family: var(--font);
      font-size: 1.2rem;
      font-weight: 400;
      text-transform: uppercase;

      a {
        display: flex;
        color: #fff;

        span {
          display: inline-block;
          padding: 5px 10px;
          margin-left: -10px;
          border-radius: 50%;
          color: #fff;
          background-color: #000;

          &:nth-child(1) {
            margin-left: 0;
          }
        }
      }
    }

    nav {
      ul {
        display: flex;

        li {
          margin-left: 1rem;

          &:hover {
            a {
              color: #fff;
              background-color: #282828;
              border-radius: 20px;
            }
          }

          a {
            display: inline-block;
            padding: 2px 5px;
            font-size: 1.8rem;
            color: #111;
            text-transform: uppercase;
          }
        }
      }
    }
  }

}